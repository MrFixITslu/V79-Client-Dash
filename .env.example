PORT=3040
APP_URL=https://hub.v79sl.com
TRUST_PROXY=1

# First boot only. Use a unique 16+ character password.
V79_HUB_ADMIN_EMAIL=
V79_HUB_ADMIN_PASSWORD=
V79_HUB_ADMIN_NAME=
V79_HUB_ORGANIZATION_NAME=V79 Digital

# Generate once with: openssl rand -hex 32
# The exact same value must be configured in Hub, FFPRO, Tiquet and Academy.
V79_PLATFORM_SHARED_SECRET=

# Internal Docker service URLs used for signed server-to-server calls.
FFPRO_BASE_URL=http://fire-finance-app:3010
TIQUET_BASE_URL=http://v79-tiquet-manager:3050
ACADEMY_BASE_URL=http://v79_course_builder:3030

# Public URLs opened by the Hub UI.
FFPRO_PUBLIC_URL=https://ffpro.v79sl.com
TIQUET_PUBLIC_URL=https://tiquet.v79sl.com
ACADEMY_PUBLIC_URL=https://academy.v79sl.com
