APP_URL=https://hub.v79sl.com
V79_HUB_ADMIN_USERNAME=admin
# Use a unique password of at least 16 characters; never use the former demo passwords.
V79_HUB_ADMIN_PASSWORD=
# The verified Vision79 owner email. Owner Assistant access is locked to this account.
V79_HUB_ADMIN_EMAIL=vision79slu@gmail.com
# Same 32+ character value in the POS server environment.
V79_PLATFORM_SHARED_SECRET=
POS_BASE_URL=http://v79-commerce-api:8080
POS_PUBLIC_URL=https://pos.v79sl.com
FFPRO_PUBLIC_URL=https://ffpro.v79sl.com
TIQUET_PUBLIC_URL=https://tiquet.v79sl.com
MARKETING_PUBLIC_URL=https://marketing.v79sl.com
LASERTAG_INTERNAL_URL=http://lasertag:5173
WEBSITE_INTERNAL_URL=http://V79website:3000
GAMES_INTERNAL_URL=http://gaming-studio-j:80
# Each must match the corresponding product server; use a different 32+ character value for each.
V79_FFPRO_LAUNCH_SECRET=
V79_TIQUET_LAUNCH_SECRET=
V79_MARKETING_LAUNCH_SECRET=
# Optional when linking an existing POS tenant/member; do not guess existing IDs.
V79_POS_ORG_ID=
V79_POS_OWNER_USER_ID=

# PostgreSQL persistence foundation. Do not set this in production until the Hub store cutover is scheduled.
# Used by: npm run store:migrate:postgres
# DATABASE_URL=postgresql://v79hub:<strong-password>@v79-hub-postgres:5432/v79hub

# Vision79 Owner Assistant. Production generates its internal Hub↔Agent token automatically.
# V79_AGENT_API_TOKEN is an optional development/override value only.
V79_AGENT_INTERNAL_URL=http://v79-business-agent:3055
V79_AGENT_API_TOKEN=
# Production creates a separate read-only platform signing key automatically.
V79_READONLY_PLATFORM_SHARED_SECRET=
V79_AGENT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA_AGENT_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_TOKENS=140
OLLAMA_API_KEY=ollama-local
# Optional hosted fallback only.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-sol

# Read-only health endpoints. Configure each as that app exposes a health route.
V79_WEBSITE_HEALTH_URL=
V79_LASERTAG_HEALTH_URL=
V79_MARKETING_HEALTH_URL=
V79_POS_HEALTH_URL=
V79_TIQUET_HEALTH_URL=
V79_FFPRO_HEALTH_URL=
V79_ACADEMY_HEALTH_URL=
V79_GAMES_HEALTH_URL=

GEMINI_API_KEY=
