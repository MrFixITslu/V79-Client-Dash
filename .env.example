PORT=3040
APP_URL=https://hub.v79sl.com
TRUST_PROXY=1

# First boot only. Use a unique 16+ character password.
V79_HUB_ADMIN_EMAIL=
V79_HUB_ADMIN_PASSWORD=
V79_HUB_ADMIN_NAME=
V79_HUB_ORGANIZATION_NAME=V79 Digital

# Generate once with: openssl rand -hex 32
# The exact same value must be configured in Hub, FFPRO, Tiquet, Marketing and Academy.
V79_PLATFORM_SHARED_SECRET=

# Internal Docker service URLs used for signed server-to-server calls.
FFPRO_BASE_URL=http://fire-finance-app:3010
TIQUET_BASE_URL=http://v79-tiquet-manager:3050
ACADEMY_BASE_URL=http://v79_course_builder:3030
MARKETING_BASE_URL=http://v79marketing-app:3070

# Public URLs opened by the Hub UI.
FFPRO_PUBLIC_URL=https://ffpro.v79sl.com
TIQUET_PUBLIC_URL=https://tiquet.v79sl.com
ACADEMY_PUBLIC_URL=https://v79academy.v79sl.com/academy
MARKETING_PUBLIC_URL=https://marketing.v79sl.com

# Phase 2 inbound event secrets. Generate a different 32+ character value for each source.
V79_WEBSITE_EVENT_SECRET=
V79_TIQUET_EVENT_SECRET=
V79_FFPRO_EVENT_SECRET=
V79_ACADEMY_EVENT_SECRET=
V79_MARKETING_EVENT_SECRET=

# Single-use Hub -> Marketing launch exchange. Use a different 32+ character secret.
V79_MARKETING_LAUNCH_SECRET=
V79_FFPRO_LAUNCH_SECRET=
V79_TIQUET_LAUNCH_SECRET=

# POS beta registration is free and separate from Hub suite subscriptions.
# Change mode to production only after POS UI, migration, SSO and payment gates pass.
# Production mode denies beta-only access; an operator must convert accounts explicitly.
V79_POS_ACCESS_MODE=beta
V79_POS_BETA_SIGNUP=1

# Customer onboarding. Public signup becomes available only when this is 1
# AND transactional email is fully configured below.
V79_SELF_SERVICE_SIGNUP=0
V79_TRIAL_DAYS=14

# Transactional account email. Disabled by default.
# The first adapter uses Resend's HTTPS email API; no mail package is required.
# Verify the sending domain with the provider before enabling public signup.
V79_MAIL_PROVIDER=disabled
RESEND_API_KEY=
V79_MAIL_FROM=V79 Digital <no-reply@v79sl.com>

# Hub security hardening. Generate each secret once and keep it stable across deploys.
# MFA-enrolled accounts cannot be decrypted if V79_HUB_MFA_KEY is lost or changed.
# Generate with: openssl rand -hex 32
V79_HUB_MFA_KEY=
V79_AUDIT_HASH_KEY=

# When a product is temporarily unavailable, Hub may show the last verified
# privacy-minimised summary for this many minutes. Default: 24 hours.
V79_SUMMARY_CACHE_MAX_AGE_MINUTES=1440


# Phase 6 billing. Disabled by default: V79 will not accept card payments until
# a verified gateway account and exact Saint Lucia merchant configuration are set.
# Supported first adapter: wipay
V79_BILLING_PROVIDER=disabled

# Obtain these values from the verified WiPay Business/Developer account.
# Do not guess the country endpoint/currency; WiPay's public St. Lucia and generic
# API pages currently publish different territory details.
WIPAY_PAYMENT_URL=
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_COUNTRY_CODE=
WIPAY_CURRENCY=XCD
WIPAY_ENVIRONMENT=sandbox

# Optional comma-separated extra WiPay checkout hostnames if merchant onboarding
# provides a hosted-page domain outside *.wipayfinancial.com.
WIPAY_ALLOWED_HOSTS=
